{
  "manifest_version": 3,
  "name": "Florilege",
  "description": "A personal oracle - displays curated content from your Notion database on every new tab",
  "version": "1.0.0",
  "permissions": [
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Florilege Settings"
  }
}
