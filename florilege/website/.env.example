# Florilege Environment Variables
# Copy this file to .env.local for local development
# Add these to Vercel as environment variables for production

# Your Notion Integration Token (starts with "secret_")
# Get this from: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_your_token_here

# Your Notion Database ID (32 characters)
# Found in your database URL
NOTION_DATABASE_ID=your_database_id_here
